# HustleBot Environment Variables

# Required: Your Kilo API key (for AI scoring + proposals) — https://kilo.ai
KILO_API_KEY=sk-kilo-xxxxx

# Optional: override the default Kilo model (default: kilo-auto/free)
# KILO_MODEL=reflection/beam-free

# Optional: keep Anthropic for fallback
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Optional: Twitter/X API for live tweet scanning
TWITTER_BEARER_TOKEN=

# Optional: Apify API key for enhanced Upwork scraping
APIFY_API_KEY=

# Upwork credentials for automatic login (Playwright)
UPWORK_EMAIL=
UPWORK_PASSWORD=
UPWORK_SECURITY_ANSWER=

# Freelancer credentials for automatic login (Playwright)
FREELANCER_EMAIL=
FREELANCER_PASSWORD=

# Twitter/X credentials for automatic login (Playwright)
TWITTER_EMAIL=
TWITTER_PASSWORD=

# Hacker News credentials for automatic login (Playwright)
HACKERNEWS_USERNAME=
HACKERNEWS_PASSWORD=

# Fiverr credentials for automatic login (Playwright)
FIVERR_EMAIL=
FIVERR_PASSWORD=

# Django Community Jobs (https://www.djangoproject.com/community/jobs/) — no credentials needed (public RSS feed)
